    <!-- Permission Rationale Dialogs -->
    <string name="rationale_mic_title">Allow Microphone for Sound Gate?</string>
    <string name="rationale_mic_body">Tripwire Pulse only measures loudness in decibels (dB) in temporary memory to help confirm real bumps and ignore gentle desk vibrations. Audio is never recorded, saved, or sent anywhere. You can decline and still use the shake sensor offline.</string>
    <string name="rationale_notif_title">Allow Alert Notifications?</string>
    <string name="rationale_notif_body">Notifications let Tripwire Pulse show a local alert banner if your phone senses movement while watching a door or bag. You can decline and still see live visual alerts inside the app.</string>
